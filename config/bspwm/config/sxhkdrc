# Show help
alt + F1
    OpenApps --KeyHelp

# -- Basic -- #

# Open Terminal (Normal)
super + Return
    OpenApps --terminal

# Open Terminal (Floating)
super + alt + Return
    OpenApps --floating

# App launcher
super + @space
    OpenApps --menu

# Theme Selector
alt + @space
    RiceSelector

# Bar Selector
super + alt + @space
    BarSelector

# -- BSPWM CONTROL -- #

# Close Window
super + x
    bspc node -c

# Reload BSPWM
super + alt + r
    bspc wm -r

# Reload sxhkd Keybinds
super + Escape
    pkill -USR1 -x sxhkd; dunstify -u low -i ~/.config/bspwm/config/assets/reload.svg 'sxhkd' 'The configuration file has been reloaded successfully!'

# Log out BSPWM session
ctrl + super + alt + q
    bspc quit

# Soft reload, mostly reload only daemons.
ctrl + super + alt + s
    SoftReload

# -- Window states and flags -- #

# Kill Window
super + shift + x
    bspc node -k

# Set Window State: Tiled Mode
super + shift + t
    bspc node -t '~tiled'

# Set Window State: Floating Mode
super + shift + a
    bspc node -t '~floating'

# Set Window State: Fullscreen Mode
super + shift + f
    bspc node -t '~fullscreen'

# Hide window
alt + h
    HideNode --hide

# Show menu to restore hidden windows
ctrl + alt + h
    HideNode --menu

# -- Move/Resize Windows -- #

# Rotate desktop 90º
super + slash
    bspc node @parent -R 90

# Resize All Windows Equally
super + equal
    bspc node @/ -B

# Resize: shrink width (falls back to the opposite edge at screen borders)
super + ctrl + {Left,h}
	bspc node -z right -40 0 || bspc node -z left 40 0

# Resize: expand width
super + ctrl + {Right,l}
	bspc node -z right 40 0 || bspc node -z left -40 0

# Resize: expand height
super + ctrl + {Down,j}
	bspc node -z bottom 0 40 || bspc node -z top 0 40

# Resize: shrink height
super + ctrl + {Up,k}
	bspc node -z bottom 0 -40 || bspc node -z top 0 -40

# Increase FLOATING winsdows size
super + ctrl + plus
    bspc node -z top_left -50 -25; bspc node -z bottom_right 50 25

# Shrink FLOATING winsdows size
super + ctrl + minus
    bspc node -z top_left 50 25; bspc node -z bottom_right -50 -25

# -- Window/Workspace Navigation -- #

# Switch workspace
super + {Left,Right}
    bspc desktop -f {prev,next}

# Move to a specific workspace
super + {1-9,0}
    bspc desktop -f '^{1-9,10}'

# Send a window to a specific workspace
super + ctrl + {1-9,0}
    bspc node -d '^{1-9,10}'

# Send focused window to workspace directionally
ctrl + shift + {Left,Right}
    bspc node -d {prev,next} '--follow'

# Change focus to Left window
super + alt + Left
    DIR=west FALLBACK=prev; \
    bspc node -f $DIR.!sticky.!hidden.local || bspc node -f $FALLBACK.leaf.!sticky.!hidden.local

# Change focus to window Below
super + alt + Down
    DIR=south; \
    bspc node -f $DIR.!sticky.!hidden.local

# Change focus to window Above
super + alt + Up
    DIR=north; \
    bspc node -f $DIR.!sticky.!hidden.local

# Change focus to Right window
super + alt + Right
    DIR=east FALLBACK=next; \
    bspc node -f $DIR.!sticky.!hidden.local || bspc node -f $FALLBACK.leaf.!sticky.!hidden.local

# Focus the last Window
ctrl + shift + comma
    bspc node -f last

# Focus the last Desktop
ctrl + shift + period
    bspc desktop -f last

# Swap Focused Window with Left Window
super + shift + Left
    bspc node -s west.local

# Swap Focused Window with Window Below
super + shift + Down
    bspc node -s south.local

# Swap Focused Window with Window Above
super + shift + Up
    bspc node -s north.local

# Swap Focused Window with Right Window
super + shift + Right
    bspc node -s east.local

# Window switcher
alt + Tab
    rofi \
        -theme $HOME/.config/bspwm/config/rofi-themes/Windows.rasi \
        -show window -window-thumbnail \
        -window-hide-active-window true \
        -kb-accept-entry "!Alt-Tab,Return" \
        -kb-element-next "Alt-Tab"

