# jgmenu
~button3
    win=$(xdotool getmouselocation --shell | sed -n 's/^WINDOW=\(.*\)/\1/p'); \
    type=$(xprop -id "$win" _NET_WM_WINDOW_TYPE 2>/dev/null); \
    case "$type" in *DESKTOP*) \
        jgmenu_run ;; esac

# Power off system
ctrl + super + alt + p
    systemctl poweroff

# Reboot system
ctrl + super + alt + r
    systemctl reboot

# Lockscreen
ctrl + super + alt + l
    ScreenLocker

# Hide Bar (Polybar and/or eww)
super + alt + h
    HideBar -h

# Unhide Bar (Polybar and/or eww)
super + alt + u
    HideBar -u

# Increase transparency on focused window
ctrl + alt + plus
    picom-trans -c -3

# Decrease transparency on focused window
ctrl + alt + minus
    picom-trans -c +3

# Reset transparency on focused window
ctrl + alt + t
    picom-trans -c -d

# Manage brightness
XF86MonBrightness{Up,Down}
    sh Brightness {up,down}

# Volume control
XF86Audio{RaiseVolume,LowerVolume,Mute}
    Volume{ --inc, --dec, --toggle}

# Music Control
XF86Audio{Next,Prev,Play,Stop}
    MediaControl {--next,--previous,--toggle,--stop}
