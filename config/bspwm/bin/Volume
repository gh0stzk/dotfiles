# Icon directory
vol_dir="$HOME/.config/bspwm/config/assets"

notify() {
    dunstify -u low -h string:x-dunst-stack-tag:cvolum "$@"
}

# Get volume status (prints "muted" or a bare number, no %)
get_volume() {
    status=$(pamixer --get-volume-human)

    case "$status" in
        muted) echo muted ;;
        *) echo "${status%\%}" ;;
    esac
}

# Determine icon based on a volume value (muted|0|N)
get_icon() {
    case "$1" in
        muted|0) icon="$vol_dir/mute.png" ;;
        *) icon="$vol_dir/vol.png" ;;
    esac
}

# Show notification
show_notification() {
    local vol

    vol=$(get_volume)
    get_icon "$vol"

    if [ "$vol" = "muted" ]; then
        notify -i "$icon" "Volumen: muted"
    else
        notify -i "$icon" "Volumen: ${vol}%"
    fi
}

# Adjust volume
adjust_volume() {
    pamixer --unmute
    pamixer --allow-boost --set-limit 150 "$@"
    show_notification
}

# Toggle mute
toggle_mute() {
    local vol

    pamixer --toggle-mute

    if [ "$(pamixer --get-mute)" = "true" ]; then
        get_icon muted
        notify -i "$icon" "Muted"
    else
        vol=$(get_volume)
        get_icon "$vol"
        notify -i "$icon" "Unmuted"
    fi
}

# Handle options
case "$1" in
    --get)    get_volume ;;
    --inc)    adjust_volume -i 5 ;;
    --dec)    adjust_volume -d 5 ;;
    --toggle) toggle_mute ;;
    *)
        vol=$(get_volume)
        case "$vol" in
            muted) echo muted ;;
            *) echo "${vol}%" ;;
        esac
        ;;
esac
