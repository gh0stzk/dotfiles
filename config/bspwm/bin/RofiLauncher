#
# Script Name: RofiLauncher
# Description: Dynamic theme selector and launcher for Rofi
#
# Copyright (C) 2021-2026 gh0stzk <z0mbi3.zk@protonmail.com>
# Licensed under GPL-3.0 license
# =============================================================

# Main vars
cfgStyle="$HOME/.config/bspwm/config/.launcher"
[ -f "$cfgStyle" ] || echo "1" > "$cfgStyle"
read -r current_style < "$cfgStyle"

# Paths
styleDir="$HOME/.config/bspwm/config/rofi-themes"
rofiAssetDir="$HOME/.config/bspwm/config/assets"

# Function to select the styles
choose_launcher_style() {

    # Find styles
    styles=$(find "$styleDir" -type f -name 'style_*.rasi' | sed 's|.*/style_\([0-9]*\)\.rasi|\1|' | sort -n)

    # Find current style
    selected_index=-1
    index=0
    IFS='
'
    for style in $styles; do
        if [ "$style" = "$current_style" ]; then
            selected_index=$index
            break
        fi
        index=$((index + 1))
    done
    unset IFS

    # Show the rofi selection menu
    selected=$(
    IFS='
'
    for style in $styles; do
        printf "%s\000icon\037%s/style_%s.webp\n" "$style" "$rofiAssetDir" "$style"
    done | rofi -dmenu \
                -theme "$styleDir/StyleSelect.rasi" \
                -selected-row "$selected_index"
    )

    # Write the selection to config file
    [ -n "$selected" ] && echo "${selected}" > "$cfgStyle"

}

launch_launcher () {
    ROFI_THEME="$styleDir/style_$current_style.rasi"
    start_mode="${1:-Apps}"

    # Styles without a mode-switcher get one ("Apps" / "Everything" tabs)
    extra_theme=""
    if ! grep -q 'mode-switcher' "$ROFI_THEME"; then
        extra_theme='
            listbox { children: [ "mode-switcher", "listview" ]; }
            mode-switcher { spacing: 10px; background-color: transparent; }
            button { padding: 6px; border-radius: 4px; cursor: pointer;
                     background-color: @background-alt; text-color: @foreground; }
            button selected { background-color: @selected; text-color: @background; }'
    fi

    # Ctrl+Tab (or clicking the tabs) switches between Apps and Everything
    rofi -modes "Apps:$HOME/.config/bspwm/bin/RofiApps,drun" \
         -display-drun "Everything" \
         -show "$start_mode" \
         -theme "$ROFI_THEME" \
         -theme-str "$extra_theme"
}

# -- Main executor -- #
case "$1" in
    --choose-style)
        choose_launcher_style ;;
    --all)
        launch_launcher drun ;;
    --apps | --launcher | *)
        launch_launcher Apps ;;
esac
